# EvoForge Environment Configuration

# GitHub Settings
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Providers (Add keys as needed based on active providers)
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
# OLLAMA_HOST=http://localhost:11434  # Default is usually fine

# Application Settings
EVOFORGE_LOG_LEVEL=INFO
EVOFORGE_DATA_DIR=./data  # Where SQLite db and workspaces will be stored
